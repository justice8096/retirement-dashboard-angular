# Required by @analogjs/vite-plugin-angular: it declares a peerOptional on
# @angular-devkit/build-angular (the legacy webpack builder), but this
# project uses the modern @angular/build (Vite-based application builder).
# Both are listed in the plugin's peer-deps allowed range, but npm's strict
# resolver gets confused trying to install both. legacy-peer-deps=true
# tells npm to not try resolving optional peers — install completes cleanly,
# and `npm ci` finds the lockfile internally consistent.
#
# Tracked as a known constraint of the Vitest test infrastructure (PR #113).
legacy-peer-deps=true
